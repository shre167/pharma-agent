# Copy to .env and fill in. Never commit .env.
GE_API_KEY=YOUR_CAPGEMINI_GENERATIVE_ENGINE_KEY
LLM_BASE_URL=https://openai.generative.engine.capgemini.com/v1
LLM_MODEL=openai.gpt-5-mini

# Embeddings are served by a separate endpoint (Titan only exists on the Capgemini gateway).
# Leave EMBEDDING_API_KEY / EMBEDDING_BASE_URL empty to reuse GE_API_KEY / LLM_BASE_URL.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openai.generative.engine.capgemini.com/v1
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Optional: LangSmith tracing (Wave 2 observability). Leave blank to disable.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pharma-design-report-agent

# Optional tuning
LLM_TEMPERATURE=0.1
AGENT_MAX_ITERATIONS=8
