# Copy to .env and fill in. Never commit .env.
#
# Option A - Capgemini Generative Engine (LLM + Titan embeddings):
GE_API_KEY=YOUR_CAPGEMINI_GENERATIVE_ENGINE_KEY
LLM_BASE_URL=https://openai.generative.engine.capgemini.com/v1
LLM_MODEL=openai.gpt-5-mini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openai.generative.engine.capgemini.com/v1
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Option B - all Mistral (LLM + embeddings):
# GE_API_KEY=YOUR_MISTRAL_API_KEY
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-large-latest
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.mistral.ai/v1
# EMBEDDING_MODEL=mistral-embed
#
# Mixed setups: point LLM_* at one provider and EMBEDDING_* at another.
# Whenever EMBEDDING_MODEL or EMBEDDING_BASE_URL changes, rebuild: python scripts/ingest.py --rebuild

# Optional: LangSmith tracing (Wave 2 observability). Leave blank to disable.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pharma-design-report-agent

# Optional tuning
LLM_TEMPERATURE=0.1
AGENT_MAX_ITERATIONS=8
